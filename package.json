{
  "name": "@agents-web-search/core",
  "version": "1.0.0",
  "description": "Agent-agnostic web-search core: 14 search engines (keyless SERP, API, and provider-native), a SQLite-cached SSRF-guarded fetch, platform search, the web store (history/cache), and model-facing tools. Hosts integrate through the HostAdapter contract (DSH and Pi adapters live in the @agents-web-search workspace).",
  "keywords": [
    "web-search",
    "web-fetch",
    "agent",
    "core",
    "multi-engine",
    "provider-native",
    "ssrf",
    "platforms"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:no-host-imports": "node scripts/no-host-imports.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "unpdf": "^1.8.1"
  },
  "optionalDependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stelmakhdigital/core-web-search.git"
  },
  "homepage": "https://github.com/stelmakhdigital/core-web-search#readme",
  "bugs": {
    "url": "https://github.com/stelmakhdigital/core-web-search/issues"
  }
}
